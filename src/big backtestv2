                    continue

                signal_a = (y['Close'] > y['SMA200'] and y['RSI2'] < 10)
                signal_b = (y['Close'] > y['SMA200'] and y['RSI2'] < 5)

                if signal_a or signal_b:
                    entry_price = df.loc[date, 'Open']
                    entry_price = apply_entry_friction(entry_price)
                    stop = entry_price - (1.0 * y['ATR14'])
                    shares = position_size(entry_price, stop, equity)
                    total_cost = shares * entry_price + COMMISSION
                    if shares > 0 and cash >= total_cost:
                        cash -= total_cost
