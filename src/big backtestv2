import pandas as pd
import numpy as np
import yfinance as yf
import matplotlib.pyplot as plt

# ==========================================
# SHARED PARAMETERS
# ==========================================
START_CAPITAL = 100000
RISK_PER_TRADE = 0.01
MAX_SECTOR_POSITIONS = 2
MAX_TOTAL_POSITIONS = 6
MAX_ALLOC_FRACTION = 1/6

SLIPPAGE_ENTRY = 0.0005
SLIPPAGE_EXIT  = 0.0005
COMMISSION = 1.0
RISK_FREE_ANNUAL = 0.045
DAILY_RF = RISK_FREE_ANNUAL / 252

tickers = ['MSFT','AMZN','JPM','UNH','XOM','WMT','NVDA','AMD','META','TSLA']
sectors = {
    'MSFT':'Tech','NVDA':'Tech','AMD':'Tech','META':'Tech',
    'AMZN':'Consumer','TSLA':'Consumer','WMT':'Consumer',
    'JPM':'Finance','UNH':'Healthcare','XOM':'Energy'
}

# ==========================================
# DATA LOADING
# ==========================================
def load_data():
    print("Downloading historical data...")
    data = yf.download(tickers + ['^GSPC'], start="2023-01-01", end="2026-07-03")
    return data

# ==========================================
# INDICATORS
# ==========================================
def build_indicators(data):
    close = data['Close']
    high = data['High']
    low = data['Low']
    vol = data['Volume']

    ind = {}

    for t in tickers:
        df = pd.DataFrame(index=close.index)
        df['Close'] = close[t]
        df['Open'] = data['Open'][t]
        df['High'] = high[t]
        df['Low'] = low[t]
        df['Vol'] = vol[t]

        # Trend indicators
        df['SMA50'] = df['Close'].rolling(50).mean()
        df['SMA20'] = df['Close'].rolling(20).mean()
        df['EMA20'] = df['Close'].ewm(span=20).mean()
        df['SMA5'] = df['Close'].rolling(5).mean()
        df['SMA200'] = df['Close'].rolling(200).mean()

        # Volume indicators
        df['AvgVol30'] = df['Vol'].rolling(30).mean()

        # Breakout indicators
        df['Prior20High'] = df['Close'].rolling(20).max().shift(1)

        # ATR(14)
        tr1 = df['High'] - df['Low']
        tr2 = (df['High'] - df['Close'].shift(1)).abs()
        tr3 = (df['Low'] - df['Close'].shift(1)).abs()
        df['ATR14'] = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1).rolling(14).mean()

        # RSI(2)
        delta = df['Close'].diff()
        gain = delta.clip(lower=0)
        loss = -delta.clip(upper=0)
        avg_gain = gain.rolling(2).mean()
        avg_loss = loss.rolling(2).mean()
        rs = avg_gain / avg_loss.replace(0, np.nan)
        df['RSI2'] = 100 - (100 / (1 + rs))

        # Keltner Channels
        df['KC_MID'] = df['EMA20']
        df['KC_UPPER'] = df['EMA20'] + 2 * df['ATR14']
        df['KC_LOWER'] = df['EMA20'] - 2 * df['ATR14']

        ind[t] = df

    sp500 = close['^GSPC']
    sp500_sma200 = sp500.rolling(200).mean()

    return ind, sp500, sp500_sma200

# ==========================================
# UTILITIES
# ==========================================
def apply_entry_friction(price):
    return price * (1 + SLIPPAGE_ENTRY)

def apply_exit_friction(price):
    return price * (1 - SLIPPAGE_EXIT)

def apply_cash_drag(cash):
    return cash * (1 + DAILY_RF)

def gap_down_exit(open_price, stop_price, close_price):
    if open_price < stop_price:
        return open_price
    return close_price

def position_size(entry_price, stop_price, equity):
    risk_dist = entry_price - stop_price
    if risk_dist <= 0:
        return 0
    risk_dollars = equity * RISK_PER_TRADE
    shares_risk = risk_dollars / risk_dist
    max_alloc = equity * MAX_ALLOC_FRACTION
    shares_alloc = max_alloc / entry_price
    return int(min(shares_risk, shares_alloc))

def sector_cap_reached(open_positions, sector):
    count = sum(1 for p in open_positions.values() if p['sector'] == sector)
    return count >= MAX_SECTOR_POSITIONS

# ==========================================
# MODEL A — YANG (Trend Following)
# ==========================================
def run_yang(ind, data, sp500, sp500_sma200):
    cash = START_CAPITAL
    equity = START_CAPITAL
    open_positions = {}
    trade_log = []
    equity_curve = []
    daily_returns = []

    dates = ind[tickers[0]].index[200:]

    for i in range(1, len(dates)):
        date = dates[i]
        prev_date = dates[i-1]

        cash = apply_cash_drag(cash)
        market_ok = sp500.loc[prev_date] > sp500_sma200.loc[prev_date]

        # EXITS
        to_close = []
        for t, pos in open_positions.items():
            df = ind[t]
            close_price = df.loc[date, 'Close']
            sma50 = df.loc[date, 'SMA50']
            if close_price < sma50 or close_price <= pos['stop']:
                to_close.append(t)

        for t in to_close:
            pos = open_positions.pop(t)
            df = ind[t]
            open_price = df.loc[date, 'Open']
            close_price = df.loc[date, 'Close']
            exit_price = gap_down_exit(open_price, pos['stop'], close_price)
            exit_price = apply_exit_friction(exit_price)
            cash += pos['shares'] * exit_price
            cash -= COMMISSION
            pnl = (exit_price - pos['entry']) * pos['shares']
            trade_log.append({
                'ticker': t,
                'entry_date': pos['entry_date'],
                'exit_date': date,
                'entry_price': pos['entry'],
                'exit_price': exit_price,
                'shares': pos['shares'],
                'pnl': pnl
            })

        # ENTRIES
        if market_ok and len(open_positions) < MAX_TOTAL_POSITIONS:
            for t in tickers:
                if t in open_positions:
                    continue
                df = ind[t]
                y = df.loc[prev_date]
                sector = sectors[t]
                if sector_cap_reached(open_positions, sector):
                    continue

                signal_a = (
                    y['Close'] > y['SMA50'] and
                    y['Vol'] > y['AvgVol30'] and
                    y['Close'] > y['Prior20High']
                )

                signal_b = (
                    y['Close'] > y['SMA50'] and
                    y['Vol'] < y['AvgVol30'] and
                    y['Close'] <= (y['SMA20'] + 2 * y['ATR14'])
                )

                if signal_a or signal_b:
                    entry_price = df.loc[date, 'Open']
                    entry_price = apply_entry_friction(entry_price)
                    stop = entry_price - (2 * y['ATR14'])
                    shares = position_size(entry_price, stop, equity)
                    total_cost = shares * entry_price + COMMISSION
                    if shares > 0 and cash >= total_cost:
                        cash -= total_cost
                        open_positions[t] = {
                            'entry': entry_price,
                            'stop': stop,
                            'shares': shares,
                            'sector': sector,
                            'entry_date': date
                        }

        # EQUITY UPDATE
        open_val = sum(
            open_positions[t]['shares'] * ind[t].loc[date, 'Close']
            for t in open_positions
        )
        prev_equity = equity
        equity = cash + open_val
        if i > 1:
            daily_returns.append((equity - prev_equity) / prev_equity)
        equity_curve.append(equity)

    return {
        'name': 'Yang',
        'equity_curve': equity_curve,
        'trade_log': trade_log,
        'daily_returns': daily_returns
    }

# ==========================================
# MODEL B — ZHAN (Volatility Expansion)
# ==========================================
def run_zhan(ind, data, sp500, sp500_sma200):
    cash = START_CAPITAL
    equity = START_CAPITAL
    open_positions = {}
    trade_log = []
    equity_curve = []
    daily_returns = []

    dates = ind[tickers[0]].index[200:]

    for i in range(1, len(dates)):
        date = dates[i]
        prev_date = dates[i-1]

        cash = apply_cash_drag(cash)
        market_ok = sp500.loc[prev_date] > sp500_sma200.loc[prev_date]

        # EXITS
        to_close = []
        for t, pos in open_positions.items():
            df = ind[t]
            close_price = df.loc[date, 'Close']
            kc_lower = df.loc[date, 'KC_LOWER']
            if close_price < kc_lower or close_price <= pos['stop']:
                to_close.append(t)

        for t in to_close:
            pos = open_positions.pop(t)
            df = ind[t]
            open_price = df.loc[date, 'Open']
            close_price = df.loc[date, 'Close']
            exit_price = gap_down_exit(open_price, pos['stop'], close_price)
            exit_price = apply_exit_friction(exit_price)
            cash += pos['shares'] * exit_price
            cash -= COMMISSION
            pnl = (exit_price - pos['entry']) * pos['shares']
            trade_log.append({
                'ticker': t,
                'entry_date': pos['entry_date'],
                'exit_date': date,
                'entry_price': pos['entry'],
                'exit_price': exit_price,
                'shares': pos['shares'],
                'pnl': pnl
            })

        # ENTRIES
        if market_ok and len(open_positions) < MAX_TOTAL_POSITIONS:
            for t in tickers:
                if t in open_positions:
                    continue
                df = ind[t]
                y = df.loc[prev_date]
                sector = sectors[t]
                if sector_cap_reached(open_positions, sector):
                    continue

                # Locate integer position for yesterday to safely step backward
                idx = df.index.get_loc(prev_date)
                
                # Enforce safe buffer limit for index calculation
                if idx < 4:
                    cons = False
                    true_pierce = False
                else:
                    # A. Consolidation Check: Prior 3 days inside bands
                    cons = True
                    for j in range(1, 4):
                        c = df.iloc[idx - j]['Close']
                        if not (c < df.iloc[idx - j]['KC_UPPER'] and c > df.iloc[idx - j]['KC_LOWER']):
                            cons = False
                            break
                    
                    # B. NEW PATCH: True pierce check (the day before yesterday was below EMA)
                    y_close_prev2 = df.iloc[idx - 1]['Close']
                    y_ema20_prev2 = df.iloc[idx - 1]['EMA20']
                    true_pierce = y_close_prev2 <= y_ema20_prev2

                # Module A: High Volume Volatility Expansion
                signal_a = (
                    y['Close'] > y['KC_UPPER'] and
                    y['Vol'] > y['AvgVol30'] and
                    cons
                )

                # Module B: Corrected Low Volume True Pierce
                signal_b = (
                    y['Close'] > y['EMA20'] and
                    true_pierce and          # Enforced true cross logic
                    y['Vol'] < y['AvgVol30']
                )

                if signal_a or signal_b:
                    entry_price = df.loc[date, 'Open']
                    entry_price = apply_entry_friction(entry_price)
                    stop = entry_price - (1.5 * y['ATR14'])
                    shares = position_size(entry_price, stop, equity)
                    total_cost = shares * entry_price + COMMISSION
                    if shares > 0 and cash >= total_cost:
                        cash -= total_cost
                        open_positions[t] = {
                            'entry': entry_price,
                            'stop': stop,
                            'shares': shares,
                            'sector': sector,
                            'entry_date': date
                        }

        # EQUITY UPDATE
        open_val = sum(
            open_positions[t]['shares'] * ind[t].loc[date, 'Close']
            for t in open_positions
        )
        prev_equity = equity
        equity = cash + open_val
        if i > 1:
            daily_returns.append((equity - prev_equity) / prev_equity)
        equity_curve.append(equity)

    return {
        'name': 'Zhan',
        'equity_curve': equity_curve,
        'trade_log': trade_log,
        'daily_returns': daily_returns
    }

