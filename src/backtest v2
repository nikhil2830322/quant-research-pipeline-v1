import pandas as pd
import numpy as np
import yfinance as yf
import matplotlib.pyplot as plt

# ==========================================
# 1. SETUP PARAMETERS & UNIVERSE
# ==========================================
START_PORTFOLIO = 100000.0
RISK_PER_TRADE = 0.01
MAX_SECTOR_POSITIONS = 2
MAX_TOTAL_POSITIONS = 6
MAX_ALLOCATION_FRACTION = 1/6

SLIPPAGE_ENTRY = 0.0005   # +0.05%
SLIPPAGE_EXIT  = 0.0005   # -0.05%
COMMISSION_PER_TRADE = 1.0
RISK_FREE_ANNUAL = 0.045
DAILY_RF = RISK_FREE_ANNUAL / 252

tickers = ['MSFT','AMZN','JPM','UNH','XOM','WMT','NVDA','AMD','META','TSLA']
sectors = {
    'MSFT':'Tech','NVDA':'Tech','AMD':'Tech','META':'Tech',
    'AMZN':'Consumer','TSLA':'Consumer','WMT':'Consumer',
    'JPM':'Finance','UNH':'Healthcare','XOM':'Energy'
}

print("Downloading historical data...")
data = yf.download(tickers + ['^GSPC'], start="2023-01-01", end="2026-07-03")
close = data['Close']
high = data['High']
low = data['Low']
vol = data['Volume']

# ==========================================
# 2. INDICATORS (NO LOOK-AHEAD)
# ==========================================
ind = {}

for t in tickers:
    df = pd.DataFrame(index=close.index)
    df['Close'] = close[t]
    df['High'] = high[t]
    df['Low'] = low[t]
    df['Vol'] = vol[t]

    df['SMA50'] = df['Close'].rolling(50).mean()
    df['SMA20'] = df['Close'].rolling(20).mean()
    df['AvgVol30'] = df['Vol'].rolling(30).mean()

    # PRIOR 20-DAY HIGH (shifted to avoid look-ahead)
    df['Prior20High'] = df['Close'].rolling(20).max().shift(1)

    # ATR(14)
    tr1 = df['High'] - df['Low']
    tr2 = (df['High'] - df['Close'].shift(1)).abs()
    tr3 = (df['Low'] - df['Close'].shift(1)).abs()
    df['ATR14'] = pd.concat([tr1, tr2, tr3], axis=1).max(axis=1).rolling(14).mean()

    ind[t] = df

# Market filter
sp500 = close['^GSPC']
sp500_sma200 = sp500.rolling(200).mean()

# ==========================================
# 3. SIMULATION ENGINE (BIAS-FREE)
# ==========================================
portfolio_value = START_PORTFOLIO
cash = START_PORTFOLIO
open_positions = {}

equity_curve = []
daily_returns = []
trade_log = []

dates = close.index[200:]  # start after indicators mature

for i in range(1, len(dates)):
    date = dates[i]
    prev_date = dates[i-1]

    # Apply cash drag interest
    cash *= (1 + DAILY_RF)

    # Market filter
    market_ok = sp500.loc[prev_date] > sp500_sma200.loc[prev_date]

    # ============================
    # A. EXITS (today's close, with gap-down handling)
    # ============================
    to_close = []
    for t, pos in open_positions.items():
        c = ind[t].loc[date, 'Close']
        sma50 = ind[t].loc[date, 'SMA50']

        # Exit conditions
        if c < sma50 or c <= pos['stop']:
            to_close.append(t)

    for t in to_close:
        pos = open_positions.pop(t)

        # Gap-down simulator: use today's open if below stop
        open_price = data['Open'][t].loc[date]
        if open_price < pos['stop']:
            exit_price = open_price
        else:
            exit_price = ind[t].loc[date, 'Close']

        # Apply slippage & commission
        exit_price *= (1 - SLIPPAGE_EXIT)
        cash += pos['shares'] * exit_price
        cash -= COMMISSION_PER_TRADE

        pnl = (exit_price - pos['entry']) * pos['shares']
        trade_log.append({
            'ticker': t,
            'entry_date': pos['entry_date'],
            'exit_date': date,
            'entry_price': pos['entry'],
            'exit_price': exit_price,
            'shares': pos['shares'],
            'pnl': pnl
        })

    # ============================
    # B. ENTRIES (signals from prev_date, enter at today's open)
    # ============================
    if market_ok and len(open_positions) < MAX_TOTAL_POSITIONS:

        for t in tickers:
            if t in open_positions:
                continue

            df = ind[t]

            # Yesterday's values (signal day)
            y_close = df.loc[prev_date, 'Close']
            y_sma50 = df.loc[prev_date, 'SMA50']
            y_prior_high = df.loc[prev_date, 'Prior20High']
            y_vol = df.loc[prev_date, 'Vol']
            y_avgvol30 = df.loc[prev_date, 'AvgVol30']
            y_atr = df.loc[prev_date, 'ATR14']

            # Sector cap
            sector = sectors[t]
            sector_count = sum(1 for p in open_positions.values() if p['sector'] == sector)
            if sector_count >= MAX_SECTOR_POSITIONS:
                print(f"[{date}] SECTOR CAP BLOCKED: {t} ({sector})")
                continue

            # Entry Module A (High Volume Breakout)
            signal_a = (y_close > y_sma50) and (y_vol > y_avgvol30) and (y_close > y_prior_high)

            # Entry Module B (Low Volume Pullback)
            signal_b = (y_close > y_sma50) and (y_vol < y_avgvol30) and (y_close <= (df.loc[prev_date,'SMA20'] + 2*y_atr))

            if signal_a or signal_b:
                # Enter at today's open
                entry_price = data['Open'][t].loc[date]
                entry_price *= (1 + SLIPPAGE_ENTRY)  # slippage
                stop = entry_price - (2 * y_atr)
                risk_dist = entry_price - stop

                if risk_dist <= 0:
                    continue

                # Risk sizing
                risk_dollars = portfolio_value * RISK_PER_TRADE
                shares_risk = risk_dollars / risk_dist

                # Allocation cap
                max_alloc = portfolio_value * MAX_ALLOCATION_FRACTION
                shares_alloc = max_alloc / entry_price

                shares = int(min(shares_risk, shares_alloc))

                total_cost = shares * entry_price + COMMISSION_PER_TRADE

                if shares > 0 and cash >= total_cost:
                    cash -= total_cost
                    open_positions[t] = {
                        'entry': entry_price,
                        'stop': stop,
                        'shares': shares,
                        'sector': sector,
                        'entry_date': date
                    }

    # ============================
    # C. EQUITY UPDATE
    # ============================
    open_val = sum(open_positions[t]['shares'] * ind[t].loc[date, 'Close'] for t in open_positions)
    prev_equity = portfolio_value
    portfolio_value = cash + open_val

    if i > 1:
        daily_returns.append((portfolio_value - prev_equity) / prev_equity)

    equity_curve.append(portfolio_value)

# ==========================================
# 4. PERFORMANCE METRICS
# ==========================================

eq = pd.Series(equity_curve)

# Running peak
running_peak = eq.cummax()

# Drawdown series
drawdown = (eq - running_peak) / running_peak

# Maximum drawdown
max_drawdown = drawdown.min() * 100

# Sharpe Ratio (risk-free rate = 0 for now)
if np.std(daily_returns) != 0:
    sharpe_ratio = (np.mean(daily_returns) / np.std(daily_returns)) * np.sqrt(252)
else:
    sharpe_ratio = 0

# Sortino Ratio (downside std only)
downside_returns = [r for r in daily_returns if r < 0]
if len(downside_returns) > 0 and np.std(downside_returns) != 0:
    sortino_ratio = (np.mean(daily_returns) / np.std(downside_returns)) * np.sqrt(252)
else:
    sortino_ratio = 0

# Profit Factor & Win/Loss
gross_profit = sum(tr['pnl'] for tr in trade_log if tr['pnl'] > 0)
gross_loss = -sum(tr['pnl'] for tr in trade_log if tr['pnl'] < 0)

if gross_loss > 0:
    profit_factor = gross_profit / gross_loss
else:
    profit_factor = np.nan

wins = sum(1 for tr in trade_log if tr['pnl'] > 0)
losses = sum(1 for tr in trade_log if tr['pnl'] < 0)
total_trades = wins + losses

if total_trades > 0:
    win_rate = wins / total_trades * 100
else:
    win_rate = 0

# ==========================================
# 5. SUMMARY
# ==========================================
final_return = (portfolio_value - START_PORTFOLIO) / START_PORTFOLIO * 100

print("\n==============================")
print("YANG STRATEGY BACKTEST SUMMARY")
print("==============================")
print(f"Starting Capital : ${START_PORTFOLIO:,.2f}")
print(f"Ending Capital   : ${portfolio_value:,.2f}")
print(f"Total Return     : {final_return:.2f}%")
print(f"Max Drawdown     : {max_drawdown:.2f}%")
print(f"Sharpe Ratio     : {sharpe_ratio:.3f}")
print(f"Sortino Ratio    : {sortino_ratio:.3f}")
print(f"Profit Factor    : {profit_factor:.3f}")
print(f"Win Rate         : {win_rate:.2f}%")
print(f"Total Trades     : {total_trades}")
print(f"Open Positions   : {list(open_positions.keys())}")
print("==============================")

# ==========================================
# 6. EXPORTS & VISUALS
# ==========================================

# Trade log CSV
pd.DataFrame(trade_log).to_csv("yang_trades.csv", index=False)

# Equity curve vs S&P (normalized)
plt.figure(figsize=(12,6))
plt.plot(eq.index, eq.values, label="Yang Equity Curve")
sp_norm = (sp500.loc[eq.index] / sp500.loc[eq.index].iloc[0]) * START_PORTFOLIO
plt.plot(eq.index, sp_norm.values, label="S&P 500 (Normalized)")
plt.legend()
plt.title("Yang Strategy vs S&P 500")
plt.xlabel("Date")
plt.ylabel("Portfolio Value")
plt.grid(True)
plt.show()

# Drawdown underwater chart
plt.figure(figsize=(12,4))
plt.fill_between(drawdown.index, drawdown.values * 100, 0, color='red')
plt.title("Drawdown Underwater Chart (%)")
plt.xlabel("Date")
plt.ylabel("Drawdown %")
plt.grid(True)
plt.show()
