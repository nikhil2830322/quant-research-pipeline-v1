def run_yang(ind, data, sp500, sp500_sma200):
    cash = START_CAPITAL
    equity = START_CAPITAL
    open_positions = {}
    trade_log = []
    equity_curve = []
    daily_returns = []

    dates = ind[tickers[0]].index[200:]  # start after indicators mature

    for i in range(1, len(dates)):
        date = dates[i]
        prev_date = dates[i-1]

        # Apply cash drag
        cash = apply_cash_drag(cash)

        # Market filter
        market_ok = sp500.loc[prev_date] > sp500_sma200.loc[prev_date]

        # ============================
        # A. EXITS
        # ============================
        to_close = []
        for t, pos in open_positions.items():
            df = ind[t]
            close_price = df.loc[date, 'Close']
            sma50 = df.loc[date, 'SMA50']

            # Exit conditions
            if close_price < sma50 or close_price <= pos['stop']:
                to_close.append(t)

        for t in to_close:
            pos = open_positions.pop(t)
            df = ind[t]

            open_price = data['Open'][t].loc[date]
            close_price = df.loc[date, 'Close']

            exit_price = gap_down_exit(open_price, pos['stop'], close_price)
            exit_price = apply_exit_friction(exit_price)

            cash += pos['shares'] * exit_price
            cash -= COMMISSION

            pnl = (exit_price - pos['entry']) * pos['shares']
            trade_log.append({
                'ticker': t,
                'entry_date': pos['entry_date'],
                'exit_date': date,
                'entry_price': pos['entry'],
                'exit_price': exit_price,
                'shares': pos['shares'],
                'pnl': pnl
            })

        # ============================
        # B. ENTRIES
        # ============================
        if market_ok and len(open_positions) < MAX_TOTAL_POSITIONS:

            for t in tickers:
                if t in open_positions:
                    continue

                df = ind[t]

                # Yesterday's values
                y_close = df.loc[prev_date, 'Close']
                y_sma50 = df.loc[prev_date, 'SMA50']
                y_prior_high = df.loc[prev_date, 'Prior20High']
                y_vol = df.loc[prev_date, 'Vol']
                y_avgvol30 = df.loc[prev_date, 'AvgVol30']
                y_atr = df.loc[prev_date, 'ATR14']

                # Sector cap
                sector = sectors[t]
                if sector_cap_reached(open_positions, sector):
                    continue

                # Entry Module A (High Volume Breakout)
                signal_a = (
                    y_close > y_sma50 and
                    y_vol > y_avgvol30 and
                    y_close > y_prior_high
                )

                # Entry Module B (Low Volume Pullback)
                signal_b = (
                    y_close > y_sma50 and
                    y_vol < y_avgvol30 and
                    y_close <= (df.loc[prev_date, 'SMA20'] + 2 * y_atr)
                )

                if signal_a or signal_b:
                    entry_price = data['Open'][t].loc[date]
                    entry_price = apply_entry_friction(entry_price)

                    stop = entry_price - (2 * y_atr)
                    shares = position_size(entry_price, stop, equity)

                    total_cost = shares * entry_price + COMMISSION

                    if shares > 0 and cash >= total_cost:
                        cash -= total_cost
                        open_positions[t] = {
                            'entry': entry_price,
                            'stop': stop,
                            'shares': shares,
                            'sector': sector,
                            'entry_date': date
                        }

        # ============================
        # C. EQUITY UPDATE
        # ============================
        open_val = sum(
            open_positions[t]['shares'] * ind[t].loc[date, 'Close']
            for t in open_positions
        )
        prev_equity = equity
        equity = cash + open_val

        if i > 1:
            daily_returns.append((equity - prev_equity) / prev_equity)

        equity_curve.append(equity)

    return {
        'name': 'Yang',
        'equity_curve': equity_curve,
        'trade_log': trade_log,
        'daily_returns': daily_returns
    }

