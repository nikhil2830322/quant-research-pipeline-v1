# 2. METRICS & DASHBOARD
# ==========================================
def compute_metrics(model):
    eq = pd.Series(model['equity_curve'])
    daily = pd.Series(model['daily_returns'])
    trades = model['trade_log']
    
    running_peak = eq.cummax()
    drawdown = (eq - running_peak) / running_peak
    
    sharpe = (daily.mean() / daily.std()) * np.sqrt(252) if daily.std() != 0 else 0
    
    downside = daily[daily < 0]
    sortino = (daily.mean() / downside.std()) * np.sqrt(252) if len(downside) > 0 and downside.std() != 0 else 0
    
    gross_profit = sum(tr['pnl'] for tr in trades if tr['pnl'] > 0)
    gross_loss = -sum(tr['pnl'] for tr in trades if tr['pnl'] < 0)
    
    return {
        'name': model['name'],
        'total_return': (eq.iloc[-1] - START_CAPITAL) / START_CAPITAL * 100,
        'max_dd': drawdown.min() * 100,
        'sharpe': sharpe,
        'sortino': sortino,
        'profit_factor': gross_profit / gross_loss if gross_loss > 0 else np.nan,
        'win_rate': (sum(1 for tr in trades if tr['pnl'] > 0) / len(trades) * 100) if len(trades) > 0 else 0,
        'total_trades': len(trades),
        'equity_curve': eq,
        'drawdown': drawdown,
        'trade_log': trades
    }

def compare_models(results):
    metrics = [compute_metrics(r) for r in results]
    
    # Visuals
    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 10))
    for m in metrics: ax1.plot(m['equity_curve'], label=m['name'])
    ax1.set_title("Equity Curves")
    for m in metrics: ax2.plot(m['drawdown'] * 100, label=m['name'])
    ax2.set_title("Drawdowns (%)")
    plt.show()
    
    # Table
    table = pd.DataFrame(metrics).drop(columns=['equity_curve', 'drawdown', 'trade_log'])
    print("\n--- PERFORMANCE SUMMARY ---")
    print(table.to_string(index=False))

