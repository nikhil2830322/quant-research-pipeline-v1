        df['SMA5'] = df['Close'].rolling(5).mean()
        df['SMA200'] = df['Close'].rolling(200).mean()
        df['AvgVol30'] = df['Vol'].rolling(30).mean()
        df['Prior20High'] = df['Close'].rolling(20).max().shift(1)
        tr = pd.concat([(df['High']-df['Low']), (df['High']-df['Close'].shift(1)).abs(), (df['Low']-df['Close'].shift(1)).abs()], axis=1).max(axis=1)
        df['ATR14'] = tr.rolling(14).mean()
        delta = df['Close'].diff()
        rs = (delta.clip(lower=0).rolling(2).mean()) / (-delta.clip(upper=0).rolling(2).mean()).replace(0, np.nan)
        df['RSI2'] = 100 - (100 / (1 + rs))
        df['KC_UPPER'] = df['EMA20'] + 2 * df['ATR14']
        df['KC_LOWER'] = df['EMA20'] - 2 * df['ATR14']
        ind[t] = df
    return ind, data[('Close', '^GSPC')], data[('Close', '^GSPC')].rolling(200).mean()

