        for t in to_close:
            pos = open_positions.pop(t)
            exit_p = apply_exit_friction(gap_down_exit(data[('Open', t)].loc[date], pos['stop'], ind[t].loc[date, 'Close']))
            cash += (pos['shares'] * exit_p) - COMMISSION
